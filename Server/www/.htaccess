# HabboretroV14 — service Apache (Laragon)
# Types MIME Shockwave/Director : indispensables pour que le client se charge
# et sauvegarde correctement (sinon Apache renvoie octet-stream et ça casse).
AddType application/x-director .dcr .cct .cst .cxt .cxt
AddType application/x-shockwave-flash .swf

# Page par défaut = le site
DirectoryIndex index.php index.html

# Pas de listing de dossier
Options -Indexes

# Anciennes adresses d'aide Habbo (/help, /help/75, /help/36…) -> Centre d'aide du site
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^help(/.*)?$ /?p=help [R=301,L]
</IfModule>
