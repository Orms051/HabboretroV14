# HabboretroV14 — service Apache (Laragon)
# Types MIME Shockwave/Director : indispensables pour que le client se charge
# et sauvegarde correctement (sinon Apache renvoie octet-stream et ça casse).
AddType application/x-director .dcr .cct .cst .cxt
AddType application/x-shockwave-flash .swf

# ===== Bascule V2 -> site principal =====
# La V2 est servie à la racine (boot.php inclus via __DIR__, OK en DirectoryIndex).
# La V1 reste le fichier index.php (conservé pour rollback) mais n'est plus
# atteignable publiquement : /index.php est redirigé vers / (voir plus bas).
# ROLLBACK = restaurer l'ancien .htaccess (DirectoryIndex index.php, sans ces règles).
# Racine -> v2/index.php ; les sous-dossiers (ex. /admin/) retombent sur leur index.php.
DirectoryIndex v2/index.php index.php index.html

# Pas de listing de dossier
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Anciennes adresses /v2/... -> racine, en conservant les paramètres.
    # IMPORTANT : on ne redirige que les requêtes RÉELLES vers /v2/ (THE_REQUEST),
    # jamais la sous-requête interne de DirectoryIndex (/ -> v2/index.php) : sinon
    # boucle de redirection entre / et /v2/index.php.
    # POST -> 308 (préserve la méthode et le corps : pas de perte de données de
    # formulaire) ; GET -> 301 (permanent, mis en cache).
    RewriteCond %{THE_REQUEST} \s/+v2/ [NC]
    RewriteCond %{REQUEST_METHOD} =POST
    RewriteRule ^v2/(.*)$ /$1 [R=308,L,QSA]

    RewriteCond %{THE_REQUEST} \s/+v2/ [NC]
    RewriteRule ^v2/?(index\.php)?$ / [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/+v2/ [NC]
    RewriteRule ^v2/(.+)$ /$1 [R=301,L,QSA]

    # Ancienne V1 : /index.php -> racine (V2). Uniquement sur requête réelle.
    RewriteCond %{THE_REQUEST} \s/+index\.php [NC]
    RewriteRule ^index\.php$ / [R=301,L,QSA]

    # Anciennes adresses d'aide Habbo (/help, /help/75…) -> Centre d'aide.
    RewriteRule ^help(/.*)?$ /?p=help [R=301,L]
</IfModule>

# ===== Blindage : rien de sensible accessible depuis le navigateur =====
# Logs, dumps SQL, scripts et docs internes.
<FilesMatch "\.(log|sql|md|ps1|bat|sh|ini|bak|example)$">
    Require all denied
</FilesMatch>
# Dossiers d'outils / migrations / sauvegardes éventuelles sous la racine web.
RedirectMatch 404 ^/(tools|_migrations|_backups_refonte)(/|$)
# Données internes du manuel des commandes et du convertisseur d'avatars.
RedirectMatch 404 ^/admin/(tools|data)(/|$)
RedirectMatch 404 ^/avatar/(cache|minerva-scripts)(/|$)
