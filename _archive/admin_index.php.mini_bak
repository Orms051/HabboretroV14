<?php
/* ============================================================
   HabboretroV14 — Panneau d'administration (propre, autonome)
   PDO -> MariaDB 127.0.0.1:3306 / base v14
   Login : compte du jeu de rang >= 5 (mot de passe argon2id/bcrypt)
   Servir avec PHP 8.3 (php -S). Accès : http://localhost/admin/
   ============================================================ */
session_start();
error_reporting(E_ALL & ~E_DEPRECATED & ~E_NOTICE);
date_default_timezone_set('Europe/Paris');

const DB_HOST = '127.0.0.1';
const DB_PORT = 3306;
const DB_NAME = 'v14';
const DB_USER = 'root';
const DB_PASS = '';
const RANG_ADMIN = 5;          // rang minimum pour accéder
const HOTEL = 'HabboretroV14';

function db(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $pdo = new PDO(
            'mysql:host='.DB_HOST.';port='.DB_PORT.';dbname='.DB_NAME.';charset=utf8mb4',
            DB_USER, DB_PASS,
            [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
             PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
             PDO::ATTR_TIMEOUT => 3]
        );
    }
    return $pdo;
}
function h($s): string { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); }
function csrf(): string { if (empty($_SESSION['csrf'])) $_SESSION['csrf'] = bin2hex(random_bytes(16)); return $_SESSION['csrf']; }
function csrf_field(): string { return '<input type="hidden" name="csrf" value="'.csrf().'">'; }
function csrf_ok(): bool { return isset($_POST['csrf']) && hash_equals($_SESSION['csrf'] ?? '', $_POST['csrf']); }
function flash($m,$t='ok'){ $_SESSION['flash'][] = [$t,$m]; }
function post($k,$d=''){ return $_POST[$k] ?? $d; }
function get($k,$d=''){ return $_GET[$k] ?? $d; }
function verif_mdp(string $saisi, string $stocke): bool {
    if ($stocke === '') return false;
    if ($stocke[0] === '$') return password_verify($saisi, $stocke); // argon2id / bcrypt
    return hash_equals($stocke, $saisi); // legacy texte clair
}
function hash_mdp(string $clair): string { return password_hash($clair, PASSWORD_ARGON2ID); }

/* -------- Auth -------- */
$erreur_login = '';
if (($_POST['action'] ?? '') === 'login') {
    try {
        $u = db()->prepare('SELECT id,username,password,rank FROM users WHERE username = ? LIMIT 1');
        $u->execute([trim(post('username'))]);
        $row = $u->fetch();
        if ($row && verif_mdp(post('password'), $row['password'])) {
            if ((int)$row['rank'] >= RANG_ADMIN) {
                session_regenerate_id(true);
                $_SESSION['uid'] = (int)$row['id'];
                $_SESSION['uname'] = $row['username'];
                $_SESSION['urank'] = (int)$row['rank'];
                header('Location: ?'); exit;
            } else { $erreur_login = 'Ton rang ('.$row['rank'].') est insuffisant (rang '.RANG_ADMIN.'+ requis).'; }
        } else { $erreur_login = 'Identifiant ou mot de passe incorrect.'; }
    } catch (Throwable $e) { $erreur_login = 'Base indisponible : '.$e->getMessage(); }
}
if (get('logout') !== '') { session_destroy(); header('Location: ?'); exit; }
$connecte = !empty($_SESSION['uid']);

/* -------- Page de login -------- */
if (!$connecte) {
    ?><!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title><?= HOTEL ?> — Admin</title><style>
    :root{--bg:#0f1720;--card:#1b2735;--ac:#3aa0ff;--tx:#e8eef5;--mut:#8fa3b8}
    *{box-sizing:border-box}body{margin:0;font-family:'Segoe UI',system-ui,sans-serif;background:linear-gradient(135deg,#0f1720,#16324a);color:var(--tx);height:100vh;display:flex;align-items:center;justify-content:center}
    .box{background:var(--card);padding:32px;border-radius:14px;width:340px;box-shadow:0 12px 40px rgba(0,0,0,.5)}
    h1{margin:0 0 4px;font-size:22px}p.sub{margin:0 0 20px;color:var(--mut);font-size:13px}
    label{display:block;font-size:12px;color:var(--mut);margin:12px 0 4px}
    input{width:100%;padding:10px;border-radius:8px;border:1px solid #2c3e52;background:#0f1a26;color:var(--tx);font-size:14px}
    button{width:100%;margin-top:18px;padding:11px;border:0;border-radius:8px;background:var(--ac);color:#04121f;font-weight:700;font-size:15px;cursor:pointer}
    .err{background:#3a1a1f;border:1px solid #e2555f;color:#ffb9be;padding:10px;border-radius:8px;font-size:13px;margin-top:14px}
    </style></head><body>
    <form class="box" method="post">
      <h1>🛠️ <?= HOTEL ?></h1><p class="sub">Panneau d'administration</p>
      <input type="hidden" name="action" value="login">
      <label>Nom d'utilisateur</label><input name="username" autofocus autocomplete="username">
      <label>Mot de passe</label><input type="password" name="password" autocomplete="current-password">
      <button type="submit">Connexion</button>
      <?php if ($erreur_login): ?><div class="err"><?= h($erreur_login) ?></div><?php endif; ?>
    </form></body></html><?php
    exit;
}

/* ============================================================
   ZONE CONNECTÉE
   ============================================================ */
$p = get('p', 'dashboard');

/* -------- Actions POST -------- */
if ($_SERVER['REQUEST_METHOD'] === 'POST' && ($_POST['action'] ?? '') !== 'login') {
    if (!csrf_ok()) { flash('Jeton CSRF invalide, réessaie.', 'err'); header('Location: ?p='.urlencode($p)); exit; }
    $act = post('action');
    try {
        switch ($act) {
            case 'user_save': {
                $id = (int)post('id');
                db()->prepare('UPDATE users SET rank=?, credits=?, tickets=?, film=?, motto=?, figure=?, email=? WHERE id=?')
                    ->execute([(int)post('rank'),(int)post('credits'),(int)post('tickets'),(int)post('film'),
                               post('motto'),post('figure'),post('email'),$id]);
                if (post('newpass') !== '') {
                    db()->prepare('UPDATE users SET password=? WHERE id=?')->execute([hash_mdp(post('newpass')),$id]);
                }
                if (post('badge') !== '') {
                    db()->prepare('UPDATE users SET badge=?, badge_active=1 WHERE id=?')->execute([substr(post('badge'),0,3),$id]);
                }
                flash('Utilisateur mis à jour.'); header('Location: ?p=users&id='.$id); exit;
            }
            case 'user_create': {
                $un = trim(post('username'));
                if ($un==='' || post('password')==='') { flash('Nom et mot de passe requis.','err'); header('Location: ?p=user_new'); exit; }
                $ex = db()->prepare('SELECT id FROM users WHERE username=?'); $ex->execute([$un]);
                if ($ex->fetch()) { flash('Ce nom existe déjà.','err'); header('Location: ?p=user_new'); exit; }
                db()->prepare('INSERT INTO users (username,password,figure,sex,motto,rank,email,credits) VALUES (?,?,?,?,?,?,?,?)')
                    ->execute([$un,hash_mdp(post('password')),post('figure','hd-180-1.ch-255-66.lg-280-110.sh-305-62'),
                               post('sex','M')==='F'?'F':'M',post('motto','Nouveau sur HabboretroV14'),(int)post('rank',1),post('email',''),(int)post('credits',200)]);
                flash('Utilisateur créé.'); header('Location: ?p=users&q='.urlencode($un)); exit;
            }
            case 'user_ban': {
                $uid=(int)post('id'); $days=(int)post('days'); $msg=post('message','Banni par un administrateur');
                $until = $days>0 ? (int)((time()+$days*86400)*1000) : 0; // 0 = définitif, ms
                db()->prepare('INSERT INTO users_bans (ban_type,banned_value,message,banned_until) VALUES (\'USER_ID\',?,?,?)
                               ON DUPLICATE KEY UPDATE message=VALUES(message),banned_until=VALUES(banned_until)')
                    ->execute([(string)$uid,$msg,$until]);
                flash('Utilisateur banni.'); header('Location: ?p=users&id='.$uid); exit;
            }
            case 'ban_remove': {
                db()->prepare('DELETE FROM users_bans WHERE banned_value=? AND ban_type=?')->execute([post('value'),post('type')]);
                flash('Bannissement levé.'); header('Location: ?p=moderation'); exit;
            }
            case 'wipe_inventory': {
                $un=trim(post('username'));
                $r=db()->prepare('SELECT id FROM users WHERE username=?'); $r->execute([$un]); $row=$r->fetch();
                if(!$row){ flash('Utilisateur introuvable.','err'); header('Location: ?p=moderation'); exit; }
                $n=db()->prepare('DELETE FROM items WHERE user_id=? AND room_id=0'); $n->execute([$row['id']]);
                flash('Inventaire de '.$un.' vidé : '.$n->rowCount().' objet(s) supprimé(s) (débloque une jukebox coincée). Le joueur doit se reconnecter.'); header('Location: ?p=moderation'); exit;
            }
            case 'wipe_all_items': {
                $un=trim(post('username'));
                if (post('confirm') !== 'SUPPRIMER') { flash('Tape SUPPRIMER pour confirmer la suppression TOTALE.','err'); header('Location: ?p=moderation'); exit; }
                $r=db()->prepare('SELECT id FROM users WHERE username=?'); $r->execute([$un]); $row=$r->fetch();
                if(!$row){ flash('Utilisateur introuvable.','err'); header('Location: ?p=moderation'); exit; }
                $n=db()->prepare('DELETE FROM items WHERE user_id=?'); $n->execute([$row['id']]);
                flash('TOUS les objets de '.$un.' supprimés : '.$n->rowCount().' (inventaire + meubles posés). Le joueur doit se reconnecter.'); header('Location: ?p=moderation'); exit;
            }
            case 'room_save': {
                db()->prepare('UPDATE rooms SET name=?, description=?, category=?, is_hidden=?, visitors_max=? WHERE id=?')
                    ->execute([post('name'),post('description'),(int)post('category'),(int)post('is_hidden'),(int)post('visitors_max'),(int)post('id')]);
                flash('Appart mis à jour.'); header('Location: ?p=rooms&q='.urlencode(post('name'))); exit;
            }
            case 'cat_item_save': {
                db()->prepare('UPDATE catalogue_items SET name=?, description=?, price=?, amount=?, is_hidden=? WHERE id=?')
                    ->execute([post('name'),post('description'),(int)post('price'),(int)post('amount'),(int)post('is_hidden'),(int)post('id')]);
                flash('Article catalogue mis à jour.'); header('Location: ?p=catalogue'); exit;
            }
            case 'setting_save': {
                db()->prepare('UPDATE settings SET value=? WHERE setting=?')->execute([post('value'),post('setting')]);
                flash('Réglage enregistré.'); header('Location: ?p=settings'); exit;
            }
        }
    } catch (Throwable $e) { flash('Erreur : '.$e->getMessage(),'err'); header('Location: ?p='.urlencode($p)); exit; }
}

/* -------- Layout -------- */
function nav_item($key,$label,$cur){ $a=$key===$cur?' class="active"':''; echo '<a'.$a.' href="?p='.$key.'">'.$label.'</a>'; }
function layout_haut($p){
    $flash=$_SESSION['flash']??[]; $_SESSION['flash']=[];
    ?><!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
    <title><?= HOTEL ?> — Admin</title><style>
    :root{--bg:#0f1720;--card:#1b2735;--card2:#22344a;--ac:#3aa0ff;--tx:#e8eef5;--mut:#90a4ba;--ok:#2ec27e;--err:#e2555f;--bd:#2c3e52}
    *{box-sizing:border-box}body{margin:0;font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--tx);display:flex;min-height:100vh}
    aside{width:220px;background:#131e2a;border-right:1px solid var(--bd);padding:16px 0;flex-shrink:0}
    aside .brand{font-weight:800;font-size:17px;padding:0 18px 14px;border-bottom:1px solid var(--bd);margin-bottom:8px}
    aside a{display:block;padding:10px 18px;color:var(--tx);text-decoration:none;font-size:14px;border-left:3px solid transparent}
    aside a:hover{background:var(--card)}aside a.active{background:var(--card);border-left-color:var(--ac);color:var(--ac);font-weight:600}
    aside .out{margin-top:14px;color:var(--mut);font-size:12px;border-top:1px solid var(--bd);padding-top:12px}
    main{flex:1;padding:26px 32px;max-width:1100px}
    h1{margin:0 0 18px;font-size:24px}h2{font-size:18px;margin:24px 0 12px}
    .card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:18px;margin-bottom:18px}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
    .stat{background:var(--card2);border-radius:10px;padding:14px}.stat b{display:block;font-size:26px}.stat span{color:var(--mut);font-size:12px}
    table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:8px 10px;text-align:left;border-bottom:1px solid var(--bd)}
    th{color:var(--mut);font-weight:600}tr:hover td{background:#1e2d3f}
    label{display:block;font-size:12px;color:var(--mut);margin:10px 0 4px}
    input,select,textarea{width:100%;padding:9px;border-radius:8px;border:1px solid var(--bd);background:#0f1a26;color:var(--tx);font-size:14px}
    textarea{min-height:70px;resize:vertical}
    .row{display:flex;gap:14px;flex-wrap:wrap}.row>div{flex:1;min-width:160px}
    button,.btn{display:inline-block;padding:9px 16px;border:0;border-radius:8px;background:var(--ac);color:#04121f;font-weight:700;cursor:pointer;text-decoration:none;font-size:14px}
    .btn.sec{background:var(--card2);color:var(--tx)}.btn.danger{background:var(--err);color:#fff}.btn.ok{background:var(--ok);color:#04121f}
    .btn.sm{padding:5px 10px;font-size:12px}
    .msg{padding:11px 14px;border-radius:8px;margin-bottom:14px;font-size:14px}
    .msg.ok{background:#123528;border:1px solid var(--ok);color:#8ff0c2}.msg.err{background:#3a1a1f;border:1px solid var(--err);color:#ffb9be}
    a{color:var(--ac)} .pill{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;background:var(--card2)}
    </style></head><body>
    <aside>
      <div class="brand">🛠️ <?= HOTEL ?></div>
      <?php nav_item('dashboard','📊 Tableau de bord',$p); nav_item('users','👤 Utilisateurs',$p); nav_item('user_new','➕ Créer un compte',$p);
      nav_item('rooms','🏠 Apparts',$p); nav_item('catalogue','🛍️ Catalogue',$p); nav_item('moderation','🛡️ Modération',$p);
      nav_item('bus','🚌 Bus (Infobus)',$p); nav_item('commandes','⌨️ Commandes en jeu',$p); nav_item('settings','⚙️ Réglages',$p); ?>
      <div class="out" style="padding:12px 18px 0">Connecté : <b><?= h($_SESSION['uname']) ?></b> (rang <?= (int)$_SESSION['urank'] ?>)<br><a href="?logout=1">Déconnexion</a></div>
    </aside>
    <main>
    <?php foreach($flash as $f){ echo '<div class="msg '.$f[0].'">'.h($f[1]).'</div>'; } ?>
    <?php
}
function layout_bas(){ echo '</main></body></html>'; }

/* -------- Rendu des pages -------- */
try { $DBOK = (bool) db(); } catch (Throwable $e) { $DBOK=false; $DBERR=$e->getMessage(); }

layout_haut($p);
if (!$DBOK) { echo '<h1>Base indisponible</h1><div class="msg err">'.h($DBERR).'</div>'; layout_bas(); exit; }

switch ($p) {

case 'dashboard': {
    $uc = db()->query('SELECT COUNT(*) FROM users')->fetchColumn();
    $rc = db()->query('SELECT COUNT(*) FROM rooms')->fetchColumn();
    $ic = db()->query('SELECT COUNT(*) FROM items')->fetchColumn();
    $bc = db()->query('SELECT COUNT(*) FROM rooms_bots')->fetchColumn();
    $cc = db()->query('SELECT COUNT(*) FROM catalogue_items')->fetchColumn();
    $banc = db()->query('SELECT COUNT(*) FROM users_bans')->fetchColumn();
    echo '<h1>Tableau de bord</h1><div class="card"><div class="grid">';
    foreach ([['Utilisateurs',$uc],['Apparts',$rc],['Objets',$ic],['Bots',$bc],['Articles catalogue',$cc],['Bannissements',$banc]] as $s)
        echo '<div class="stat"><b>'.number_format($s[1],0,',',' ').'</b><span>'.$s[0].'</span></div>';
    echo '</div></div>';
    echo '<h2>Derniers inscrits</h2><div class="card"><table><thead><tr><th>ID</th><th>Nom</th><th>Rang</th><th>Crédits</th><th>Inscrit le</th><th></th></tr></thead><tbody>';
    foreach (db()->query('SELECT id,username,rank,credits,created_at FROM users ORDER BY id DESC LIMIT 15') as $u)
        echo '<tr><td>'.$u['id'].'</td><td>'.h($u['username']).'</td><td><span class="pill">'.$u['rank'].'</span></td><td>'.$u['credits'].'</td><td>'.h($u['created_at']).'</td><td><a class="btn sm" href="?p=users&id='.$u['id'].'">Éditer</a></td></tr>';
    echo '</tbody></table></div>';
    break;
}

case 'users': {
    $id = (int)get('id');
    if ($id) {
        $st=db()->prepare('SELECT * FROM users WHERE id=?'); $st->execute([$id]); $u=$st->fetch();
        if(!$u){ echo '<h1>Utilisateur introuvable</h1>'; break; }
        $img='http://localhost/habbo-imaging/avatarimage?figure='.urlencode($u['figure']).'&size=b';
        echo '<h1>Éditer : '.h($u['username']).' <span class="pill">#'.$u['id'].'</span></h1>';
        echo '<div class="row"><div class="card" style="flex:2">';
        echo '<form method="post">'.csrf_field().'<input type="hidden" name="action" value="user_save"><input type="hidden" name="id" value="'.$u['id'].'">';
        echo '<div class="row"><div><label>Rang (1-7)</label><input name="rank" value="'.h($u['rank']).'"></div>';
        echo '<div><label>Crédits</label><input name="credits" value="'.h($u['credits']).'"></div>';
        echo '<div><label>Tickets</label><input name="tickets" value="'.h($u['tickets']).'"></div>';
        echo '<div><label>Film</label><input name="film" value="'.h($u['film']).'"></div></div>';
        echo '<label>Mission</label><input name="motto" value="'.h($u['motto']).'">';
        echo '<label>Figure</label><input name="figure" value="'.h($u['figure']).'">';
        echo '<label>Email</label><input name="email" value="'.h($u['email']).'">';
        echo '<div class="row"><div><label>Badge (3 lettres, ex. ADM)</label><input name="badge" value="'.h($u['badge']).'" maxlength="3"></div>';
        echo '<div><label>Nouveau mot de passe (laisser vide = inchangé)</label><input name="newpass" type="text" placeholder="••••••"></div></div>';
        echo '<div style="margin-top:16px"><button type="submit">💾 Enregistrer</button></div></form></div>';
        echo '<div class="card" style="flex:1;text-align:center"><label>Avatar</label><img src="'.h($img).'" alt="" style="max-width:100%"><p class="pill">Vu : '.($u['last_online']?date('d/m/Y H:i',(int)$u['last_online']):'jamais').'</p></div></div>';
        // bannir
        echo '<div class="card"><h2>Bannir</h2><form method="post" class="row">'.csrf_field().'<input type="hidden" name="action" value="user_ban"><input type="hidden" name="id" value="'.$u['id'].'">';
        echo '<div><label>Durée (jours, 0 = définitif)</label><input name="days" value="0"></div><div style="flex:2"><label>Motif</label><input name="message" value="Comportement inapproprié"></div>';
        echo '<div style="flex:0 0 auto;align-self:flex-end"><button class="btn danger" type="submit">Bannir</button></div></form></div>';
        break;
    }
    $q = trim(get('q'));
    echo '<h1>Utilisateurs</h1><div class="card"><form method="get"><input type="hidden" name="p" value="users"><div class="row"><div style="flex:3"><label>Rechercher (nom / id / mission)</label><input name="q" value="'.h($q).'" autofocus></div><div style="flex:0 0 auto;align-self:flex-end"><button type="submit">Rechercher</button></div></div></form></div>';
    if ($q!=='') {
        $st=db()->prepare('SELECT id,username,rank,credits,figure,motto,last_online FROM users WHERE username LIKE ? OR id=? OR motto LIKE ? ORDER BY id DESC LIMIT 100');
        $st->execute(['%'.$q.'%', ctype_digit($q)?(int)$q:0, '%'.$q.'%']);
        echo '<div class="card"><table><thead><tr><th>ID</th><th>Nom</th><th>Rang</th><th>Crédits</th><th>Mission</th><th></th></tr></thead><tbody>';
        foreach ($st as $u) echo '<tr><td>'.$u['id'].'</td><td>'.h($u['username']).'</td><td><span class="pill">'.$u['rank'].'</span></td><td>'.$u['credits'].'</td><td>'.h($u['motto']).'</td><td><a class="btn sm" href="?p=users&id='.$u['id'].'">Éditer</a></td></tr>';
        echo '</tbody></table></div>';
    }
    break;
}

case 'user_new': {
    echo '<h1>Créer un utilisateur</h1><div class="card"><form method="post">'.csrf_field().'<input type="hidden" name="action" value="user_create">';
    echo '<div class="row"><div><label>Nom d\'utilisateur</label><input name="username" required></div><div><label>Mot de passe</label><input name="password" type="text" required></div></div>';
    echo '<div class="row"><div><label>Rang</label><input name="rank" value="1"></div><div><label>Crédits</label><input name="credits" value="200"></div><div><label>Sexe (M/F)</label><input name="sex" value="M" maxlength="1"></div></div>';
    echo '<label>Mission</label><input name="motto" value="Nouveau sur '.HOTEL.'">';
    echo '<label>Email</label><input name="email" value="">';
    echo '<div style="margin-top:16px"><button type="submit">➕ Créer</button></div></form></div>';
    break;
}

case 'rooms': {
    $id=(int)get('id');
    if ($id){
        $st=db()->prepare('SELECT * FROM rooms WHERE id=?'); $st->execute([$id]); $r=$st->fetch();
        if(!$r){ echo '<h1>Appart introuvable</h1>'; break; }
        echo '<h1>Éditer l\'appart #'.$r['id'].'</h1><div class="card"><form method="post">'.csrf_field().'<input type="hidden" name="action" value="room_save"><input type="hidden" name="id" value="'.$r['id'].'">';
        echo '<label>Nom</label><input name="name" value="'.h($r['name']).'">';
        echo '<label>Description</label><input name="description" value="'.h($r['description']).'">';
        echo '<div class="row"><div><label>Catégorie</label><input name="category" value="'.h($r['category']).'"></div><div><label>Visiteurs max</label><input name="visitors_max" value="'.h($r['visitors_max']).'"></div>';
        echo '<div><label>Masqué (0/1)</label><select name="is_hidden"><option value="0"'.($r['is_hidden']?'':' selected').'>Non</option><option value="1"'.($r['is_hidden']?' selected':'').'>Oui</option></select></div></div>';
        echo '<p class="pill">Modèle : '.h($r['model']).' · Propriétaire : '.h($r['owner_id']).'</p>';
        echo '<div style="margin-top:16px"><button type="submit">💾 Enregistrer</button></div></form></div>';
        break;
    }
    $q=trim(get('q'));
    echo '<h1>Apparts</h1><div class="card"><form method="get"><input type="hidden" name="p" value="rooms"><div class="row"><div style="flex:3"><label>Rechercher (nom)</label><input name="q" value="'.h($q).'"></div><div style="flex:0 0 auto;align-self:flex-end"><button type="submit">Rechercher</button></div></div></form></div>';
    $st=db()->prepare('SELECT id,name,owner_id,category,visitors_now,visitors_max,is_hidden FROM rooms WHERE name LIKE ? ORDER BY id DESC LIMIT 100');
    $st->execute(['%'.$q.'%']);
    echo '<div class="card"><table><thead><tr><th>ID</th><th>Nom</th><th>Propriétaire</th><th>Cat.</th><th>Visiteurs</th><th>Masqué</th><th></th></tr></thead><tbody>';
    foreach($st as $r) echo '<tr><td>'.$r['id'].'</td><td>'.h($r['name']).'</td><td>'.h($r['owner_id']).'</td><td>'.$r['category'].'</td><td>'.$r['visitors_now'].'/'.$r['visitors_max'].'</td><td>'.($r['is_hidden']?'<span class="pill">oui</span>':'non').'</td><td><a class="btn sm" href="?p=rooms&id='.$r['id'].'">Éditer</a></td></tr>';
    echo '</tbody></table></div>';
    break;
}

case 'catalogue': {
    echo '<h1>Catalogue</h1>';
    $it=(int)get('item');
    if ($it){
        $st=db()->prepare('SELECT * FROM catalogue_items WHERE id=?'); $st->execute([$it]); $c=$st->fetch();
        if($c){ echo '<div class="card"><form method="post">'.csrf_field().'<input type="hidden" name="action" value="cat_item_save"><input type="hidden" name="id" value="'.$c['id'].'">';
        echo '<label>Nom</label><input name="name" value="'.h($c['name']).'"><label>Description</label><input name="description" value="'.h($c['description']).'">';
        echo '<div class="row"><div><label>Prix</label><input name="price" value="'.h($c['price']).'"></div><div><label>Quantité</label><input name="amount" value="'.h($c['amount']).'"></div>';
        echo '<div><label>Caché</label><select name="is_hidden"><option value="0"'.($c['is_hidden']?'':' selected').'>Non</option><option value="1"'.($c['is_hidden']?' selected':'').'>Oui</option></select></div></div>';
        echo '<div style="margin-top:14px"><button type="submit">💾 Enregistrer</button> <a class="btn sec" href="?p=catalogue">Retour</a></div></form></div>'; }
    }
    $q=trim(get('q'));
    echo '<div class="card"><form method="get"><input type="hidden" name="p" value="catalogue"><div class="row"><div style="flex:3"><label>Rechercher un article</label><input name="q" value="'.h($q).'"></div><div style="flex:0 0 auto;align-self:flex-end"><button type="submit">Rechercher</button></div></div></form></div>';
    $st=db()->prepare('SELECT id,name,price,amount,is_hidden,page_id FROM catalogue_items WHERE name LIKE ? ORDER BY id LIMIT 150');
    $st->execute(['%'.$q.'%']);
    echo '<div class="card"><table><thead><tr><th>ID</th><th>Nom</th><th>Prix</th><th>Qté</th><th>Caché</th><th></th></tr></thead><tbody>';
    foreach($st as $c) echo '<tr><td>'.$c['id'].'</td><td>'.h($c['name']).'</td><td>'.$c['price'].'</td><td>'.$c['amount'].'</td><td>'.($c['is_hidden']?'oui':'non').'</td><td><a class="btn sm" href="?p=catalogue&item='.$c['id'].'">Éditer</a></td></tr>';
    echo '</tbody></table></div>';
    break;
}

case 'moderation': {
    echo '<h1>Modération</h1>';
    echo '<div class="card"><h2>🎒 Vider l\'inventaire d\'un utilisateur</h2>';
    echo '<p style="color:var(--mut);font-size:13px;margin:0 0 10px">« Vider l\'inventaire » supprime les objets non posés (la main) — débloque une jukebox coincée. Le joueur doit se reconnecter pour voir le changement.</p>';
    echo '<form method="post" class="row">'.csrf_field().'<input type="hidden" name="action" value="wipe_inventory"><div style="flex:2"><label>Nom d\'utilisateur</label><input name="username" placeholder="ex. joaowars776"></div><div style="flex:0 0 auto;align-self:flex-end"><button class="btn ok" type="submit">Vider l\'inventaire (main)</button></div></form>';
    echo '<hr style="border:0;border-top:1px solid var(--bd);margin:16px 0">';
    echo '<h2 style="margin-top:0">💥 Tout supprimer (inventaire + meubles posés)</h2>';
    echo '<p style="color:var(--err);font-size:13px;margin:0 0 10px">Action irréversible : supprime TOUS les objets du joueur (y compris les meubles posés dans ses apparts). Tape <b>SUPPRIMER</b> pour confirmer.</p>';
    echo '<form method="post" class="row" onsubmit="return confirm(\'Supprimer TOUS les objets de cet utilisateur ?\')">'.csrf_field().'<input type="hidden" name="action" value="wipe_all_items"><div style="flex:2"><label>Nom d\'utilisateur</label><input name="username"></div><div><label>Confirmation</label><input name="confirm" placeholder="SUPPRIMER"></div><div style="flex:0 0 auto;align-self:flex-end"><button class="btn danger" type="submit">Tout supprimer</button></div></form></div>';
    echo '<h2>Bannissements actifs</h2><div class="card"><table><thead><tr><th>Type</th><th>Valeur</th><th>Motif</th><th>Jusqu\'au</th><th></th></tr></thead><tbody>';
    foreach(db()->query('SELECT * FROM users_bans ORDER BY banned_until DESC LIMIT 100') as $b){
        $u = (int)$b['banned_until']===0 ? 'définitif' : date('d/m/Y H:i',(int)($b['banned_until']/1000));
        echo '<tr><td>'.h($b['ban_type']).'</td><td>'.h($b['banned_value']).'</td><td>'.h($b['message']).'</td><td>'.$u.'</td><td><form method="post" style="margin:0">'.csrf_field().'<input type="hidden" name="action" value="ban_remove"><input type="hidden" name="type" value="'.h($b['ban_type']).'"><input type="hidden" name="value" value="'.h($b['banned_value']).'"><button class="btn sm danger" type="submit">Lever</button></form></td></tr>';
    }
    echo '</tbody></table></div>';
    echo '<h2>Derniers messages (chat)</h2><div class="card"><table><thead><tr><th>Quand</th><th>Appart</th><th>User</th><th>Message</th></tr></thead><tbody>';
    foreach(db()->query('SELECT * FROM room_chatlogs ORDER BY timestamp DESC LIMIT 40') as $cl)
        echo '<tr><td>'.h(date('d/m H:i',(int)$cl['timestamp'])).'</td><td>'.h($cl['room_id']).'</td><td>'.h($cl['user_id']).'</td><td>'.h($cl['message']).'</td></tr>';
    echo '</tbody></table></div>';
    break;
}

case 'bus': {
    echo '<h1>🚌 Bus (Infobus)</h1>';
    echo '<div class="card"><p style="margin-top:0">L\'Infobus se pilote <b>en jeu</b> (l\'état vit en mémoire dans l\'émulateur, il n\'y a pas de réglage en base). Connecte-toi avec un compte <b>administrateur</b>, va dans l\'appartement du bus, et tape ces commandes dans le chat :</p>';
    echo '<table><thead><tr><th>Commande</th><th>Effet</th></tr></thead><tbody>';
    $bus = [
      [':infobus open','Ouvre le bus (les joueurs peuvent monter)'],
      [':infobus close','Ferme le bus (plus personne ne monte)'],
      [':infobus question &lt;texte&gt;','Définit la question posée aux passagers'],
      [':infobus option add &lt;texte&gt;','Ajoute une réponse possible'],
      [':infobus option remove &lt;n°&gt;','Retire la réponse n°n'],
      [':infobus status','Affiche l\'état courant du bus'],
      [':infobus reset','Réinitialise la question et les options'],
    ];
    foreach($bus as $b) echo '<tr><td style="font-family:monospace;white-space:nowrap">'.$b[0].'</td><td>'.$b[1].'</td></tr>';
    echo '</tbody></table>';
    echo '<p style="color:var(--mut);font-size:13px;margin-bottom:0">Alias : <code>:bus</code> fonctionne aussi à la place de <code>:infobus</code>. Nécessite le droit <code>fuse_administrator</code>.</p></div>';
    break;
}

case 'commandes': {
    echo '<h1>⌨️ Commandes en jeu (chat)</h1>';
    echo '<p style="color:var(--mut)">Toutes se tapent dans le chat, précédées de <b>:</b> (deux-points). Réservées aux comptes disposant du droit <b>administrateur</b> (sauf indication contraire).</p>';
    $grp = [
      'Joueurs / crédits' => [
        [':givecredits &lt;user&gt; &lt;montant&gt;','Donne des crédits à un joueur'],
        [':givebadge &lt;user&gt; &lt;badge&gt;','Attribue un badge'],
        [':giveclub &lt;user&gt; &lt;jours&gt;','Ajoute des jours de Habbo Club'],
        [':giveitem &lt;user&gt; &lt;sprite&gt;','Donne un meuble dans la main'],
        [':givedrink &lt;n°&gt;','Donne une boisson au joueur ciblé'],
      ],
      'Modération / système' => [
        [':hotelalert &lt;message&gt;','Alerte générale à tout l\'hôtel'],
        [':usersonline','Nombre de joueurs connectés (alias :whosonline)'],
        [':uptime','Depuis combien de temps l\'émulateur tourne'],
        [':reload','Recharge les données (catalogue, textes…)'],
        [':setconfig &lt;clé&gt; &lt;valeur&gt;','Modifie un réglage serveur'],
        [':setprice &lt;prix&gt;','Change le prix d\'un article du catalogue'],
        [':shutdown','Arrête proprement l\'émulateur'],
      ],
      'Appartement / soi-même' => [
        [':about / :info','Infos sur l\'émulateur'],
        [':coords','Affiche tes coordonnées dans l\'appart'],
        [':sit','Assis sur place'],
        [':afk / :idle','Passe absent (et retour)'],
        [':motto &lt;texte&gt;','Change ta mission'],
        [':poof / :update','Rafraîchit / rend invisible'],
        [':pickall','Ramasse tous les meubles de l\'appart'],
        [':talk &lt;user&gt; &lt;texte&gt;','Fait parler un joueur (bot)'],
        [':ufos','Effet OVNI'],
        [':rgb / :rainbow','Gradateur arc-en-ciel'],
      ],
      'Bus' => [
        [':infobus … / :bus …','Pilotage du bus (voir l\'onglet Bus)'],
      ],
    ];
    foreach($grp as $titre=>$cmds){
      echo '<div class="card"><h2 style="margin-top:0">'.h($titre).'</h2><table><thead><tr><th>Commande</th><th>Effet</th></tr></thead><tbody>';
      foreach($cmds as $c) echo '<tr><td style="font-family:monospace;white-space:nowrap">'.$c[0].'</td><td>'.$c[1].'</td></tr>';
      echo '</tbody></table></div>';
    }
    echo '<p style="color:var(--mut);font-size:13px">Liste établie d\'après les commandes présentes dans <code>kepler.jar</code>. Les noms entre &lt;…&gt; sont les paramètres à remplacer.</p>';
    break;
}

case 'settings': {
    echo '<h1>Réglages (settings)</h1><div class="card"><table><thead><tr><th>Clé</th><th>Valeur</th><th></th></tr></thead><tbody>';
    foreach(db()->query('SELECT setting,value FROM settings ORDER BY setting') as $s){
        echo '<tr><td style="font-family:monospace">'.h($s['setting']).'</td><td><form method="post" style="display:flex;gap:8px;margin:0">'.csrf_field().'<input type="hidden" name="action" value="setting_save"><input type="hidden" name="setting" value="'.h($s['setting']).'"><input name="value" value="'.h($s['value']).'" style="flex:1"><button class="btn sm" type="submit">OK</button></form></td><td></td></tr>';
    }
    echo '</tbody></table></div>';
    break;
}

default: echo '<h1>404</h1><p>Section inconnue.</p>';
}

layout_bas();
